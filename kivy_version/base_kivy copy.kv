MainWidget:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: root.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(50)
        padding: dp(5)
        spacing: dp(5)
        Button:
            text: 'Save to File'
            on_press: root.save_entries()
        Button:
            text: 'Load from File'
            on_press: root.load_entries()
        Button:
            text: 'Set Interface Colors...'
            on_press: root.choose_colors()
        Button:
            text: 'Reset Colors'
            on_press: root.reset_colors()
        Button:
            text: 'About'
            on_press: root.show_about()

    BoxLayout:
        size_hint_y: 0.45
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(5)
        Label:
            text: 'Alters'
            size_hint_y: None
            height: dp(30)
            color: root.fg_color
        BoxLayout:
            size_hint_y: None
            height: dp(30)
            spacing: dp(5)
            Label:
                text: 'Name'
                color: root.fg_color
                bold: True
            Label:
                text: 'Birthday'
                color: root.fg_color
                bold: True
            Label:
                text: 'Pronouns'
                color: root.fg_color
                bold: True
            Label:
                text: 'Bio'
                color: root.fg_color
                bold: True
        RecycleView:
            id: alters_rv
            viewclass: 'AlterItem'
            data: root.alters_data
            SelectableRecycleBoxLayout:
                default_size: None, dp(70)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

    BoxLayout:
        size_hint_y: 0.25
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(5)
        Label:
            text: 'Front'
            size_hint_y: None
            height: dp(30)
            color: root.fg_color
        BoxLayout:
            size_hint_y: None
            height: dp(30)
            spacing: dp(5)
            Label:
                text: 'Alter Name'
                color: root.fg_color
                bold: True
            Label:
                text: 'Timestamp'
                color: root.fg_color
                bold: True
        RecycleView:
            id: front_rv
            viewclass: 'FrontItem'
            data: root.front_data
            SelectableRecycleBoxLayout:
                default_size: None, dp(50)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

    GridLayout:
        size_hint_y: None
        height: dp(180)
        cols: 2
        row_default_height: dp(40)
        row_force_default: True
        padding: dp(10)
        spacing: dp(10)
        Label:
            text: 'Name:'
            color: root.fg_color
            size_hint_x: None
            width: dp(120)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: name_input
            multiline: False
            background_color: root.entry_bg_color
            foreground_color: root.fg_color
        Label:
            text: 'Birthday:'
            color: root.fg_color
            size_hint_x: None
            width: dp(120)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: birthday_input
            multiline: False
            background_color: root.entry_bg_color
            foreground_color: root.fg_color
        Label:
            text: 'Pronouns:'
            color: root.fg_color
            size_hint_x: None
            width: dp(120)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: pronouns_input
            multiline: False
            background_color: root.entry_bg_color
            foreground_color: root.fg_color
        Label:
            text: 'Bio:'
            color: root.fg_color
            size_hint_x: None
            width: dp(120)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: bio_input
            multiline: False
            background_color: root.entry_bg_color
            foreground_color: root.fg_color

    Widget:
        size_hint_y: None
        height: dp(10)

    GridLayout:
        size_hint_y: None
        height: dp(120)
        cols: 3
        row_default_height: dp(40)
        row_force_default: True
        padding: dp(10)
        spacing: dp(10)
        Button:
            text: 'Add Entry'
            on_press: root.add_entry()
        Button:
            text: 'Remove Selected'
            on_press: root.remove_entry()
        Button:
            text: 'Load Selected'
            on_press: root.load_selected()
        Button:
            text: 'Update Entry'
            on_press: root.update_entry()
        Button:
            text: 'Add to Front'
            on_press: root.add_to_front()
        Button:
            text: 'Remove from Front'
            on_press: root.remove_from_front()

<AlterItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.6, 0.6, 0.9, 0.4) if self.selected else (app.root.bg_color if app.root else (0.8, 0.8, 0.8, 1))
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.name
        color: app.root.fg_color if app.root else (0, 0, 0, 1)
    Label:
        text: root.birthday
        color: app.root.fg_color if app.root else (0, 0, 0, 1)
    Label:
        text: root.pronouns
        color: app.root.fg_color if app.root else (0, 0, 0, 1)
    Label:
        text: root.bio
        color: app.root.fg_color if app.root else (0, 0, 0, 1)

<FrontItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: (0.6, 0.6, 0.9, 0.4) if self.selected else (app.root.bg_color if app.root else (0.8, 0.8, 0.8, 1))
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.alter_name
        color: app.root.fg_color if app.root else (0, 0, 0, 1)
    Label:
        text: root.timestamp
        color: app.root.fg_color if app.root else (0, 0, 0, 1)